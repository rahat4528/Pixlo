# Server Environment Configuration
PORT=4004
NODE_ENV=development
FRONTEND_URL=http://localhost:3004

# Database Connection (PostgreSQL pixlo_notes_db on port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pixlo_notes_db?schema=public

# Redis Connection (on port 6384)
REDIS_HOST=localhost
REDIS_PORT=6384

# Security & Authentication
JWT_SECRET=super-secret-pixlo-notes-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d

# Storage & Upload Limits
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25MB
TRASH_RETENTION_DAYS=30
