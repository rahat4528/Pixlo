# Server Environment Configuration
PORT=4003
NODE_ENV=development
FRONTEND_URL=http://localhost:3003

# Database Connection (PostgreSQL pixlo_news_db on port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pixlo_news_db?schema=public

# Redis Connection (on port 6383)
REDIS_HOST=localhost
REDIS_PORT=6383

# Security & Authentication
JWT_SECRET=super-secret-pixlo-news-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d

# Ingestion Worker Settings
MAX_EXCERPT_LENGTH=350
FEED_FETCH_TIMEOUT_MS=8000
MAX_FEED_SIZE_BYTES=2097152
CONSECUTIVE_FAILURES_BEFORE_SUSPENSION=5
INGESTION_CRON_SCHEDULE="*/15 * * * *"
