datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  COOK
  CREATOR
  ADMIN
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
  ARBITRARY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         UserRole        @default(COOK)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile      CookProfile?
  recipes      Recipe[]        @relation("CreatorRecipes")
  ratings      RecipeRating[]
  reviews      RecipeReview[]
  savedRecipes SavedRecipe[]
  collections  RecipeCollection[]
  mealPlans    MealPlan[]
  shoppingLists ShoppingList[]
}

model CookProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String   @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  specialties     Json?    // e.g. ["Baking", "Fermentation", "Italian Pasta"]
  experienceLevel String   @default("Home Cook")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cuisine {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  recipes Recipe[]
}

model RecipeCategory {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  recipes Recipe[]
}

model DietaryTag {
  id      String      @id @default(uuid())
  name    String      @unique
  slug    String      @unique
  recipes RecipeTag[]
}

model Ingredient {
  id            String             @id @default(uuid())
  canonicalName String             @unique
  category      String             @default("Pantry") // Produce, Dairy, Meat, Pantry, Baking, Spices
  synonyms      Json?              // e.g. ["AP flour", "white flour"]
  recipes       RecipeIngredient[]
}

model Recipe {
  id              String           @id @default(uuid())
  creatorId       String
  creator         User             @relation("CreatorRecipes", fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  slug            String           @unique
  description     String
  coverImageUrl   String
  prepTimeMinutes Int
  cookTimeMinutes Int
  totalTimeMinutes Int
  servings        Int              @default(4)
  difficulty      RecipeDifficulty @default(MEDIUM)
  cuisineId       String?
  cuisine         Cuisine?         @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        RecipeCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  averageRating   Float            @default(0)
  ratingsCount    Int              @default(0)
  viewCount       Int              @default(0)
  isPublished     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  ingredients     RecipeIngredient[]
  steps           CookingStep[]
  images          RecipeImage[]
  dietaryTags     RecipeTag[]
  ratings         RecipeRating[]
  reviews         RecipeReview[]
  savedBy         SavedRecipe[]
  collectionItems RecipeCollectionItem[]
  mealPlanEntries MealPlanEntry[]

  @@index([cuisineId])
  @@index([categoryId])
  @@index([difficulty])
}

model RecipeTag {
  id       String     @id @default(uuid())
  recipeId String
  recipe   Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tagId    String
  tag      DietaryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tagId])
}

model RecipeImage {
  id         String   @id @default(uuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  orderIndex Int      @default(0)

  @@index([recipeId, orderIndex])
}

model RecipeIngredient {
  id                String        @id @default(uuid())
  recipeId          String
  recipe            Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  rawLine           String
  amountNumerator   Int           @default(1)
  amountDenominator Int           @default(1)
  unit              String
  unitDimension     UnitDimension @default(COUNT)
  notes             String?
  isScalable        Boolean       @default(true)
  orderIndex        Int           @default(0)

  @@index([recipeId, orderIndex])
}

model CookingStep {
  id           String  @id @default(uuid())
  recipeId     String
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber   Int
  instruction  String
  timerMinutes Int?
  imageUrl     String?

  @@unique([recipeId, stepNumber])
}

model RecipeRating {
  id        String   @id @default(uuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1 to 5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, userId]) // Exactly one rating per user per recipe
}

model RecipeReview {
  id        String   @id @default(uuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  rating    Int
  createdAt DateTime @default(now())

  @@index([recipeId, createdAt])
}

model SavedRecipe {
  id        String   @id @default(uuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([recipeId, userId])
}

model RecipeCollection {
  id        String                 @id @default(uuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isPrivate Boolean                @default(false)
  createdAt DateTime               @default(now())
  items     RecipeCollectionItem[]
}

model RecipeCollectionItem {
  id           String           @id @default(uuid())
  collectionId String
  collection   RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt      DateTime         @default(now())

  @@unique([collectionId, recipeId])
}

model MealPlan {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  createdAt     DateTime        @default(now())
  entries       MealPlanEntry[]
}

model MealPlanEntry {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  mealType   MealType @default(DINNER)

  @@index([mealPlanId, dayOfWeek])
}

model ShoppingList {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String             @default("Weekly Grocery List")
  createdAt DateTime           @default(now())
  items     ShoppingListItem[]
}

model ShoppingListItem {
  id                String        @id @default(uuid())
  shoppingListId    String
  shoppingList      ShoppingList  @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredientName    String
  amountNumerator   Int           @default(1)
  amountDenominator Int           @default(1)
  unit              String
  unitDimension     UnitDimension @default(COUNT)
  isCompleted       Boolean       @default(false)
  notes             String?

  @@index([shoppingListId])
}
