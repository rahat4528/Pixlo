# Environment Configuration for Recipe Sharing Platform
NODE_ENV=development
PORT=4002
FRONTEND_URL=http://localhost:3002

# Database (PostgreSQL)
DATABASE_URL="postgresql://pixlo_user:pixlo_password@localhost:5432/pixlo_recipes_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=super-secret-pixlo-recipes-jwt-key-minimum-32-characters-required
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-pixlo-recipes-refresh-jwt-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_S3_ENDPOINT=http://localhost:9003
STORAGE_S3_BUCKET=pixlo-recipes-media
STORAGE_S3_ACCESS_KEY=pixlo_minio_admin
STORAGE_S3_SECRET_KEY=pixlo_minio_secret_key
