datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CREATOR
}

enum SubscriberStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  UNSUBSCRIBED
  CLEANED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum EmailEventType {
  DELIVERED
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
  UNSUBSCRIBE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         UserRole      @default(CREATOR)
  publications Publication[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Publication {
  id                  String             @id @default(uuid())
  userId              String
  name                String
  slug                String             @unique
  description         String?
  logoUrl             String?
  websiteUrl          String?
  senderName          String
  senderEmail         String
  doubleOptIn         Boolean            @default(true)
  confirmationSubject String?
  confirmationBody    String?
  welcomeSubject      String?
  welcomeBody         String?
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscribers         Subscriber[]
  subscriberLists     SubscriberList[]
  campaigns           Campaign[]
  templates           EmailTemplate[]
  suppressions        SuppressionEntry[]
  tokens              UnsubscribeToken[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("publications")
}

model SubscriberList {
  id            String                     @id @default(uuid())
  publicationId String
  name          String
  description   String?
  isDefault     Boolean                    @default(false)
  publication   Publication                @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  memberships   SubscriberListMembership[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@map("subscriber_lists")
}

model Subscriber {
  id                String                     @id @default(uuid())
  publicationId     String
  email             String
  firstName         String?
  lastName          String?
  status            SubscriberStatus           @default(PENDING_CONFIRMATION)
  optInIp           String?
  confirmationToken String?                    @unique
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  metadata          Json?
  publication       Publication                @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  memberships       SubscriberListMembership[]
  recipients        CampaignRecipient[]
  events            EmailEvent[]
  tokens            UnsubscribeToken[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([publicationId, email])
  @@index([publicationId, status])
  @@map("subscribers")
}

model SubscriberListMembership {
  id           String         @id @default(uuid())
  subscriberId String
  listId       String
  subscriber   Subscriber     @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  list         SubscriberList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedAt      DateTime       @default(now())

  @@unique([subscriberId, listId])
  @@map("subscriber_list_memberships")
}

model EmailTemplate {
  id               String       @id @default(uuid())
  publicationId    String
  name             String
  subjectDefault   String?
  htmlContent      String
  plainTextContent String?
  previewText      String?
  isDefault        Boolean      @default(false)
  publication      Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("email_templates")
}

model Campaign {
  id               String              @id @default(uuid())
  publicationId    String
  templateId       String?
  title            String
  subject          String
  previewText      String?
  htmlBody         String
  plainTextBody    String?
  status           CampaignStatus      @default(DRAFT)
  scheduledFor     DateTime?
  sendStartedAt    DateTime?
  sendCompletedAt  DateTime?
  totalRecipients  Int                 @default(0)
  sentCount        Int                 @default(0)
  openCount        Int                 @default(0)
  clickCount       Int                 @default(0)
  bounceCount      Int                 @default(0)
  unsubscribeCount Int                 @default(0)
  publication      Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  template         EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients       CampaignRecipient[]
  events           EmailEvent[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([publicationId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String          @id @default(uuid())
  campaignId   String
  subscriberId String
  status       RecipientStatus @default(PENDING)
  trackingToken String         @unique @default(uuid())
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  firstClickedAt DateTime?
  errorMessage String?
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  events       EmailEvent[]

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model EmailEvent {
  id                  String             @id @default(uuid())
  campaignId          String
  campaignRecipientId String?
  subscriberId        String?
  type                EmailEventType
  url                 String?
  ipHash              String?
  userAgent           String?
  timestamp           DateTime           @default(now())
  campaign            Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient           CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  subscriber          Subscriber?        @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([campaignId, type])
  @@index([campaignRecipientId])
  @@map("email_events")
}

model SuppressionEntry {
  id            String            @id @default(uuid())
  publicationId String
  email         String
  reason        SuppressionReason
  detail        String?
  publication   Publication       @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([publicationId, email])
  @@index([publicationId, email])
  @@map("suppression_entries")
}

model UnsubscribeToken {
  id            String      @id @default(uuid())
  subscriberId  String
  publicationId String
  token         String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  subscriber    Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([token])
  @@map("unsubscribe_tokens")
}
