# Application Configuration
NODE_ENV=development
PORT=4005
FRONTEND_URL=http://localhost:3005
BACKEND_URL=http://localhost:4005

# Database Configuration (PostgreSQL on dedicated port 5435)
DATABASE_URL="postgresql://pixlo_user:pixlo_password@localhost:5435/pixlo_newsletter_db?schema=public"

# Redis & Queue Configuration (Redis on dedicated port 6385)
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=supersecret-pixlo-newsletter-jwt-access-key-2026
JWT_REFRESH_SECRET=supersecret-pixlo-newsletter-jwt-refresh-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Delivery Configuration
# Options: mock, smtp, ses, resend, sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM_NAME="Pixlo Newsletter"
EMAIL_FROM_ADDRESS="no-reply@pixlonewsletter.local"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Third-party Provider API Keys (if configured)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Delivery Rate Limiting (emails per second per worker)
DISPATCH_RATE_LIMIT=50
MAX_BATCH_SIZE=250

# Webhook Secrets
WEBHOOK_SECRET=pixlo-newsletter-webhook-verification-token
