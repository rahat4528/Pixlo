# Environment Configuration for Blog Platform (Medium Clone)
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://pixlo_user:pixlo_password@localhost:5431/pixlo_blog_db?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=super-secret-pixlo-blog-jwt-key-minimum-32-characters-required
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-pixlo-blog-refresh-jwt-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Local or S3/MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_S3_ENDPOINT=http://localhost:9001
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=pixlo-blog-media
STORAGE_S3_ACCESS_KEY=pixlo_minio_admin
STORAGE_S3_SECRET_KEY=pixlo_minio_secret_key

# Payment Adapter (Sandbox)
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_WEBHOOK_SECRET=sandbox-webhook-secret-key
