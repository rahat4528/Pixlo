# Environment Variables for Documentation Platform (07-documentation-platform)

PORT=4007
NODE_ENV=development
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://pixlo_docs_user:pixlo_docs_password@localhost:5437/pixlo_docs_db

# Redis Configuration
REDIS_URL=redis://localhost:6387/0

# Security & JWT
JWT_SECRET=pixlo-docs-super-secret-development-jwt-token-key-32chars
JWT_EXPIRES_IN=86400

# Documentation Engine Settings
BUILD_OUTPUT_DIR=./generator/dist
TEMPLATES_DIR=./templates
DOCS_CONTENT_DIR=./content
MAX_BUILD_CONCURRENCY=4

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4007/api/v1
PORT_FRONTEND=3007
