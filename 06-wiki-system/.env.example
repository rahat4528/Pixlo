# Wiki System Environment Configuration
ENVIRONMENT=development
PORT=4006
FRONTEND_URL=http://localhost:3006
BACKEND_URL=http://localhost:4006

# Database (PostgreSQL on dedicated port 5436)
DATABASE_URL="postgresql://pixlo_user:pixlo_password@localhost:5436/pixlo_wiki_db"
TEST_DATABASE_URL="sqlite:///./wiki_test.db"

# Redis Cache & Sessions (Redis on dedicated port 6386)
REDIS_URL="redis://localhost:6386/0"

# JWT Auth
JWT_SECRET="supersecret-pixlo-wiki-system-jwt-key-2026"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080

# Storage
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
