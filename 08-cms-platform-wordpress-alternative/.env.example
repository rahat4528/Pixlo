# Environment Variables for CMS Platform (08-cms-platform-wordpress-alternative)

PORT=4008
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://pixlo_cms_user:pixlo_cms_password@localhost:5438/pixlo_cms_db

# Redis Configuration
REDIS_URL=redis://localhost:6388/0

# Security & Secrets
JWT_SECRET=pixlo-cms-super-secret-jwt-encryption-key-32chars
API_TOKEN_SALT=pixlo-cms-api-salt-random-entropy

# Media Storage
MEDIA_UPLOAD_DIR=./media/uploads
MAX_FILE_SIZE_MB=25

# Studio Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4008/api/v1
PORT_FRONTEND=3008
